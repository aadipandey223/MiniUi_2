# VaultBeam Environment Configuration (all variables are optional)

# Optional: Point a Vercel-hosted frontend to a dedicated WebSocket signaling server
# (e.g., Render, Railway, Fly.io, or Docker) if desired. When omitted on Vercel,
# VaultBeam automatically uses its built-in authenticated Serverless HTTP signaling API.
VITE_SIGNALING_URL=

# Optional (Vercel multi-region scaling): Connect Upstash Redis or Vercel KV
# to synchronize private rooms and signaling across serverless instances.
KV_REST_API_URL=
KV_REST_API_TOKEN=
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=
